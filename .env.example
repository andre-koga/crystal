# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for auth redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (T002)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the Stripe webhook and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth providers for local Supabase (read by supabase/config.jsonc; enable the provider there too).
# Local callback URL to register with the provider: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# BYOK key encryption (T004). Server only. 32 random bytes, base64: `openssl rand -base64 32`
KEY_ENCRYPTION_SECRET=

# Billing (T010, T011). Server only.
PAYWALL_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
